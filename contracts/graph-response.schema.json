{
  "$defs": {
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "relationship": {
          "enum": [
            "CALLS",
            "MESSAGE_FLOW"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "source_service_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Service Id",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "target_service_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target Service Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "source_service_id",
        "target_service_id",
        "relationship",
        "supporting_evidence_ids"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "quality_flags": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Quality Flags",
          "type": "array"
        },
        "service_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Service Id",
          "type": "string"
        },
        "service_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Service Key",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "service_key",
        "display_name",
        "quality_flags"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "TemporalMode": {
      "enum": [
        "event_time_replay",
        "available_time_replay"
      ],
      "title": "TemporalMode",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "maxItems": 120,
      "title": "Edges",
      "type": "array"
    },
    "episode_id": {
      "format": "uuid",
      "title": "Episode Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "maxItems": 80,
      "title": "Nodes",
      "type": "array"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    },
    "temporal_mode": {
      "$ref": "#/$defs/TemporalMode"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "episode_id",
    "snapshot_id",
    "as_of",
    "temporal_mode",
    "nodes",
    "edges",
    "truncated",
    "warnings"
  ],
  "title": "GraphResponse",
  "type": "object"
}
