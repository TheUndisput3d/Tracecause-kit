{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "observation",
            "numeric",
            "relationship",
            "hypothesis",
            "limitation"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Evidence Ids",
          "type": "array"
        },
        "metric": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "path_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path Id"
        },
        "text": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "claim_type",
        "text",
        "evidence_ids",
        "metric",
        "path_id"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "conflicting_evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Conflicting Evidence Ids",
          "type": "array"
        },
        "diagnostic_check_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Diagnostic Check Ids",
          "type": "array"
        },
        "rank": {
          "maximum": 3,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "service_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Service Id",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "service_id",
        "rank",
        "claim_ids",
        "supporting_evidence_ids",
        "conflicting_evidence_ids",
        "diagnostic_check_ids"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "metric_name": {
          "enum": [
            "request_count",
            "error_count",
            "error_fraction",
            "p50_ms",
            "p95_ms",
            "latency_anomaly",
            "completeness"
          ],
          "title": "Metric Name",
          "type": "string"
        },
        "observation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "unit": {
          "enum": [
            "count",
            "fraction",
            "ms",
            "score"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "observation_id",
        "metric_name",
        "value",
        "unit",
        "interval"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Evidence Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_ids"
      ],
      "title": "Summary",
      "type": "object"
    },
    "TimeInterval": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeInterval",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 15,
      "title": "Claims",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "maxItems": 3,
      "title": "Hypotheses",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "maxItems": 15,
      "title": "Limitations",
      "type": "array"
    },
    "status": {
      "enum": [
        "supported_hypotheses",
        "insufficient_evidence",
        "no_anomaly_detected"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    }
  },
  "required": [
    "status",
    "summary",
    "hypotheses",
    "claims",
    "limitations"
  ],
  "title": "Narrative",
  "type": "object"
}
