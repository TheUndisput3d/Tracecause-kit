{
  "$defs": {
    "OperationalEvent": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 16,
          "minProperties": 1,
          "title": "Details",
          "type": "object"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deployment",
            "configuration",
            "runtime",
            "ownership",
            "incident_note"
          ],
          "title": "Kind",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/ServiceRef"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "occurred_at",
        "available_at",
        "service",
        "source",
        "details"
      ],
      "title": "OperationalEvent",
      "type": "object"
    },
    "ServiceRef": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "pattern": "^[A-Za-z0-9_.-]{1,100}$",
          "title": "Environment",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9_.-]{1,100}$",
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "pattern": "^[A-Za-z0-9_.-]{1,100}$",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "environment",
        "name"
      ],
      "title": "ServiceRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "title": "Application Id",
      "type": "string"
    },
    "artifact_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Artifact Hash",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "episode_id": {
      "format": "uuid",
      "title": "Episode Id",
      "type": "string"
    },
    "event": {
      "$ref": "#/$defs/OperationalEvent"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_json": {
      "maxLength": 20000,
      "title": "Source Json",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "episode_id",
    "snapshot_id",
    "as_of",
    "artifact_hash",
    "application_id",
    "event",
    "source_json"
  ],
  "title": "OperationalEvidence",
  "type": "object"
}
