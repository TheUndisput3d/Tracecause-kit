{
  "$defs": {
    "DataOrigin": {
      "enum": [
        "synthetic",
        "captured_demo",
        "external"
      ],
      "title": "DataOrigin",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dataset Hash",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Metrics",
      "type": "object"
    },
    "model_digest": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Digest"
    },
    "origin": {
      "$ref": "#/$defs/DataOrigin"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Published At"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "sample_size": {
      "minimum": 0,
      "title": "Sample Size",
      "type": "integer"
    },
    "split_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Split Hash",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "origin",
    "dataset_hash",
    "split_hash",
    "config_hash",
    "model_digest",
    "sample_size",
    "metrics",
    "created_at",
    "published_at"
  ],
  "title": "EvaluationReport",
  "type": "object"
}
