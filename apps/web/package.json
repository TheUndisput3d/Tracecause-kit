{
  "name": "tracecause-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../contracts/openapi.phase01.json -o src/lib/api/generated.ts",
    "test:e2e": "playwright test --grep-invert @local-llm",
    "test:e2e:llm": "playwright test --grep @local-llm"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "cytoscape": "3.34.3",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "rehype-sanitize": "6.0.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/cytoscape": "3.21.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
