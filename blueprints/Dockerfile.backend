# Target Dockerfile; referenced app/lockfiles are implemented by phase prompts.
ARG PYTHON_IMAGE
ARG UV_IMAGE
FROM ${UV_IMAGE} AS uvbin
FROM ${PYTHON_IMAGE} AS build
COPY --from=uvbin /uv /uvx /bin/
WORKDIR /app
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
COPY README.md ./
RUN uv sync --frozen --no-dev --no-editable

FROM ${PYTHON_IMAGE} AS runtime
WORKDIR /app
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid 10001 --create-home app     && mkdir -p /var/lib/tracecause/artifacts /var/lib/tracecause/staging /var/cache/huggingface     && chown -R 10001:10001 /var/lib/tracecause /var/cache/huggingface /app
COPY --from=build --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 configs ./configs
COPY --chown=10001:10001 contracts ./contracts
COPY --chown=10001:10001 prompts/runtime ./prompts/runtime
COPY --chown=10001:10001 migrations ./migrations
# Phase 00/01 must select the migration config convention and copy it here.
COPY --chown=10001:10001 alembic.ini ./alembic.ini
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "tracecause.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
