ARG PYTHON_IMAGE
ARG UV_IMAGE
FROM ${UV_IMAGE} AS uvbin
FROM ${PYTHON_IMAGE} AS build
COPY --from=uvbin /uv /uvx /bin/
WORKDIR /app
ENV UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group capture --no-install-project

FROM ${PYTHON_IMAGE} AS runtime
WORKDIR /app
RUN groupadd --gid 10001 capture && useradd --uid 10001 --gid 10001 --create-home capture
COPY --from=build --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 demo ./demo
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "demo.minishop.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
